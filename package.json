{
  "name": "fmodel-2d-cad",
  "private": true,
  "version": "0.1.0",
  "description": "FModel 2D CAD — dibujo técnico 2D preciso, local-first, en el navegador.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "check:layers": "node scripts/check-layers.mjs",
    "verify": "npm run typecheck && npm run check:layers && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tarikjabiri/dxf": "2.9.0",
    "fflate": "0.8.3",
    "lucide-react": "1.46.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.54",
    "polygon-clipping": "0.15.7",
    "rbush": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/rbush": "4.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "oxlint": "1.83.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
