{
  "name": "fmodel-2d-cad",
  "private": true,
  "version": "0.1.0",
  "description": "FModel 2D CAD — dibujo técnico 2D preciso, local-first, en el navegador.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint --deny-warnings src",
    "check:layers": "node scripts/check-layers.mjs",
    "docs:features": "node scripts/features-md.mjs",
    "check:features": "node scripts/features-md.mjs --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:layers && pnpm check:features && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mlightcad/libredwg-web": "0.7.11",
    "@tarikjabiri/dxf": "2.9.0",
    "fflate": "0.8.3",
    "lucide-react": "1.46.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.54",
    "polygon-clipping": "0.15.7",
    "rbush": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/rbush": "4.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "oxlint": "1.83.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
